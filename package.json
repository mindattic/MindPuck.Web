{
  "name": "mindpuck",
  "version": "0.1.0",
  "private": true,
  "description": "Move the puck into the goal by looking where you don't want it to go",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "start": "npm run build && node ../MindAttic.EyeTracker/bridge/server.mjs --mount /play=dist --open-path /play/",
    "levels": "node tools/levels.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@mindattic/eyetracker": "file:../MindAttic.EyeTracker",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/three": "^0.187.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.0",
    "vite": "^8.0.0",
    "vitest": "^5.1.1"
  }
}
